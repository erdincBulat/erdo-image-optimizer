#. translators: %d: number of images
#: includes/class-admin-page.php:2125
#, php-format
msgid "%d image was converted by an older version that replaced the original file. Pages that still link to the old file may show a broken image."
msgid_plural "%d images were converted by an older version that replaced the original file. Pages that still link to the old files may show broken images."
msgstr[0] "%d görsel, orijinal dosyayı değiştiren eski bir sürüm tarafından dönüştürülmüş. Hâlâ eski dosyaya bağlantı veren sayfalarda görsel kırık görünebilir."
msgstr[1] "%d görsel, orijinal dosyayı değiştiren eski bir sürüm tarafından dönüştürülmüş. Hâlâ eski dosyalara bağlantı veren sayfalarda görseller kırık görünebilir."

#: includes/class-admin-page.php:2134
msgid "Until the repair runs, the plugin redirects those links on the fly so visitors see the image."
msgstr "Onarım çalışana kadar eklenti bu bağlantıları anında yönlendirir, böylece ziyaretçiler görseli görür."

#: includes/class-admin-page.php:2138
