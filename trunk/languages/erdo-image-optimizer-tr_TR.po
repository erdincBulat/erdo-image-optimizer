#. translators: %d: number of images
#: includes/class-admin-page.php:1577
#, php-format
msgid "%d image was converted by an older version that replaced the original file. Pages that still link to the old file may show a broken image."
msgid_plural "%d images were converted by an older version that replaced the original file. Pages that still link to the old files may show broken images."
msgstr[0] "%d görsel, orijinal dosyayı değiştiren eski bir sürüm tarafından dönüştürülmüş. Hâlâ eski dosyaya bağlantı veren sayfalarda görsel kırık görünebilir."
msgstr[1] "%d görsel, orijinal dosyayı değiştiren eski bir sürüm tarafından dönüştürülmüş. Hâlâ eski dosyalara bağlantı veren sayfalarda görseller kırık görünebilir."

#: includes/class-admin-page.php:1586
msgid "Until the repair runs, the plugin redirects those links on the fly so visitors see the image."
msgstr "Onarım çalışana kadar eklenti bu bağlantıları anında yönlendirir, böylece ziyaretçiler görseli görür."

#: includes/class-admin-page.php:1590
msgid "Repair now"
msgstr "Şimdi onar"

#: includes/class-admin-page.php:1610
msgid "Repaired:"
msgstr "Onarılan:"

#: includes/class-admin-page.php:1610
msgid "remaining:"
msgstr "kalan:"

#: includes/class-admin-page.php:1638
msgid "Erdo Image Optimizer 3.0: what changed"
msgstr "Erdo Image Optimizer 3.0: neler değişti"

#: includes/class-admin-page.php:1640
msgid "Your original images are never modified or deleted any more. WebP/AVIF copies are saved next to them and served automatically."
msgstr "Orijinal görselleriniz artık asla değiştirilmez ya da silinmez. WebP/AVIF kopyaları yanlarına kaydedilir ve otomatik olarak sunulur."

#: includes/class-admin-page.php:1641
msgid "\"Delete\" now moves images to a Quarantine you can restore from, and unused-image detection uses a full index of where every image is used."
msgstr "\"Sil\" artık görselleri geri yükleyebileceğiniz bir Karantinaya taşır; kullanılmayan görsel tespiti, her görselin nerede kullanıldığını tutan tam bir indekse dayanır."

#: includes/class-admin-page.php:1642
msgid "New: 0–100 image SEO score, safe renaming with redirects, image sitemap and optional AI suggestions with your own provider key."
msgstr "Yeni: 0–100 görsel SEO puanı, yönlendirmeli güvenli yeniden adlandırma, görsel site haritası ve kendi sağlayıcı anahtarınızla isteğe bağlı AI önerileri."

#: includes/class-admin-page.php:1644
msgid "SVG uploads were removed. If you still need them, install a dedicated plugin such as Safe SVG."
msgstr "SVG yükleme kaldırıldı. Hâlâ ihtiyacınız varsa Safe SVG gibi buna özel bir eklenti kurun."

#: includes/class-admin-page.php:1647
msgid "The BunnyCDN upload was removed. Use a BunnyCDN pull zone (or your CDN plugin) instead: it picks up the WebP/AVIF copies on its own."
msgstr "BunnyCDN'e yükleme kaldırıldı. Bunun yerine bir BunnyCDN pull zone'u (ya da CDN eklentinizi) kullanın: WebP/AVIF kopyalarını kendiliğinden alır."

#: includes/class-admin-page.php:1649
msgid "Lazy loading and resizing on upload are now left to WordPress itself, which handles them better (including the largest image above the fold)."
msgstr "Tembel yükleme (lazy loading) ve yüklemede boyutlandırma artık WordPress'in kendisine bırakıldı; WordPress bunları (ekranın üstündeki en büyük görsel dahil) daha iyi yönetiyor."

#: includes/class-ai.php:45
